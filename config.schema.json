{
  "pluginAlias": "ConnectionMonitor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Pings each device every minute. Each is in HomeKit as an occupancy sensor, a switch or an outlet, occupied or on while it answers, and on the dashboard with its latency and loss.",
  "footerDisplay": "Data is kept in the connection-monitor folder of Homebridge's storage folder.",
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Connection Monitor",
        "required": true
      },
      "targets": {
        "title": "Targets",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true,
              "description": "In HomeKit and on the dashboard. The data is kept by it: renaming starts afresh."
            },
            "host": {
              "title": "IP address",
              "type": "string",
              "required": true,
              "placeholder": "192.168.1.1"
            },
            "homekit": {
              "title": "In HomeKit",
              "type": "string",
              "default": "occupancy",
              "oneOf": [
                {
                  "title": "Occupancy sensor — occupied while it answers",
                  "enum": [
                    "occupancy"
                  ]
                },
                {
                  "title": "Switch — on while it answers",
                  "enum": [
                    "switch"
                  ]
                },
                {
                  "title": "Outlet — on while it answers",
                  "enum": [
                    "outlet"
                  ]
                },
                {
                  "title": "Not in HomeKit — still on the dashboard",
                  "enum": [
                    "none"
                  ]
                }
              ]
            }
          }
        }
      },
      "stepSeconds": {
        "title": "Round every (s)",
        "type": "integer",
        "minimum": 10,
        "maximum": 3600,
        "placeholder": 60
      },
      "pings": {
        "title": "Pings per round",
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "placeholder": 20,
        "description": "Spread over nine tenths of the round."
      },
      "dashboard": {
        "title": "Dashboard",
        "type": "boolean",
        "default": true
      },
      "port": {
        "title": "Dashboard port",
        "type": "integer",
        "minimum": 1,
        "maximum": 65535,
        "placeholder": 8584
      },
      "rawDays": {
        "title": "Rounds kept as measured (days)",
        "type": "integer",
        "minimum": 1,
        "maximum": 3650,
        "placeholder": 30,
        "description": "Then folded into their hour."
      },
      "keepDays": {
        "title": "Hours kept (days)",
        "type": "integer",
        "minimum": 1,
        "maximum": 36500,
        "placeholder": 730
      }
    }
  },
  "layout": [
    "name",
    {
      "key": "targets",
      "type": "array",
      "orderable": false,
      "buttonText": "Add target",
      "items": [
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "targets[].name",
            "targets[].host",
            "targets[].homekit"
          ]
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "More",
      "expandable": true,
      "items": [
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "stepSeconds",
            "pings"
          ]
        },
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "dashboard",
            "port"
          ]
        },
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": [
            "rawDays",
            "keepDays"
          ]
        }
      ]
    }
  ]
}
