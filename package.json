{
  "name": "homebridge-connection-monitor",
  "displayName": "Connection Monitor",
  "version": "2.0.2",
  "description": "Homebridge plugin that pings your router, the internet and anything else on the network: an occupancy sensor per device in HomeKit, occupied while it answers — and latency and packet loss on a dashboard as Smokeping draws them, with Smokeping's history taken over",
  "license": "MIT",
  "author": "Oliver Rummeyer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rummeyer/homebridge-connection-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/rummeyer/homebridge-connection-monitor/issues"
  },
  "homepage": "https://github.com/rummeyer/homebridge-connection-monitor#readme",
  "main": "dist/index.js",
  "bin": {
    "connection-monitor-import": "dist/import.js"
  },
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "web",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "node --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "ping",
    "occupancy",
    "presence",
    "smokeping",
    "latency",
    "packet loss",
    "network monitor",
    "dashboard",
    "homekit"
  ],
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/rummeyer"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "homebridge": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  }
}
